[options]
mode bmc
expect pass,fail
depth 21
skip 20

[engines]
smtbmc boolector

[script]
read -sv defines.sv picorv32.v CombAssume.sv InstAssume.sv WriteBackChecker.sv testbench.sv
prep -flatten -nordff -top testbench
chformal -early

[files]
picorv32.v
CombAssume.sv
InstAssume.sv
WriteBackChecker.sv
testbench.sv

[file defines.sv]
`define RISCV_FORMAL
`define DEBUGNETS
`define DEBUGREGS
`define PICORV32_TESTBUG_NONE
