[options]
mode bmc
expect pass,fail
depth 16
skip 15

[engines]
smtbmc boolector

[script]
read -sv defines.sv picorv32.v wrapper.sv CombAssume.sv InstAssume.sv WriteBackChecker.sv testbench.sv
prep -flatten -nordff -top testbench
chformal -early

[files]
picorv32.v
wrapper.sv
CombAssume.sv
InstAssume.sv
WriteBackChecker.sv
testbench.sv

[file defines.sv]
`define YOSYS // Hotfix for older Tabby CAD Releases
`define RISCV_FORMAL
`define RISCV_FORMAL_CHECK_CYCLE 15
`define DEBUGNETS
`define DEBUGREGS
// `define PICORV32_TESTTRAP
`define PICORV32_TESTBUG_NONE
