[options]
mode bmc
expect pass,fail
append 0
depth 11
skip 10

[engines]
smtbmc boolector

[script]
read -sv defines.sv nerv.sv wrapper.sv CombAssume.sv InstAssume.sv WriteBackChecker.sv testbench.sv
prep -flatten -nordff -top testbench
chformal -early

[files]
nerv.sv
wrapper.sv
CombAssume.sv
InstAssume.sv
WriteBackChecker.sv
testbench.sv

[file defines.sv]
`define YOSYS // Hotfix for older Tabby CAD Releases
`define RISCV_FORMAL
`define RISCV_FORMAL_CHECK_CYCLE 10
`define NERV_CSR
`define NERV_PMP
`define NERV_RVFI
